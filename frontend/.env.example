# Configuration de l'API backend

# Active TLS/HTTPS pour les requetes API (true/false)
# Doit correspondre a la configuration TLS du backend
VITE_TLS_ENABLED=false

# Port de l'API backend
VITE_API_PORT=8080

# Pour activer TLS en developpement :
# 1. Generer les certificats : .\scripts\generate-certs.ps1
# 2. Activer TLS dans le backend (.env du backend)
# 3. Definir VITE_TLS_ENABLED=true ici
# 4. Redemarrer le serveur de developpement Vite
