# Configuration de la base de donnees PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=coloc_user
DB_PASSWORD=coloc_password
DB_NAME=coloc_db
DB_SSLMODE=disable

# Configuration des ports du serveur
GRPC_PORT=50051
HTTP_PORT=8080

# Configuration JWT (IMPORTANT: Changez le secret en production !)
JWT_SECRET=change-me-in-production
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=168h

# Configuration TLS/SSL
# Active le chiffrement TLS pour gRPC, HTTP et WebSocket
TLS_ENABLED=false
TLS_CERT_FILE=./certs/server-cert.pem
TLS_KEY_FILE=./certs/server-key.pem

# ==========================================
# INSTRUCTIONS D'ACTIVATION TLS
# ==========================================
#
# DEVELOPPEMENT (certificats auto-signes) :
# 1. Generer les certificats :
#    Windows : .\scripts\generate-certs.ps1
#    Linux/macOS : ./scripts/generate-certs.sh
#
# 2. Activer TLS :
#    TLS_ENABLED=true
#
# 3. Redemarrer le serveur
#
# ==========================================
# PRODUCTION (Let's Encrypt) :
# 1. Installer certbot :
#    Debian/Ubuntu : sudo apt-get install certbot
#    CentOS/RHEL : sudo yum install certbot
#
# 2. Generer le certificat :
#    sudo certbot certonly --standalone -d votredomaine.com
#
# 3. Configurer les chemins :
#    TLS_ENABLED=true
#    TLS_CERT_FILE=/etc/letsencrypt/live/votredomaine.com/fullchain.pem
#    TLS_KEY_FILE=/etc/letsencrypt/live/votredomaine.com/privkey.pem
#
# 4. Configurer le renouvellement automatique :
#    sudo crontab -e
#    Ajouter : 0 0 * * * certbot renew --quiet
#
# ==========================================
